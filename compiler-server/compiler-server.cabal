cabal-version:      3.4
name:               compiler-server
version:            0.1.0.0
author:             John Haynes
maintainer:         john.andrew.haynes@gmail.com
build-type:         Simple

executable compiler-server
    ghc-options:        -Wall -O2 -threaded
    default-extensions: DataKinds, LambdaCase, OverloadedStrings, TypeOperators
    default-language:   Haskell2010
    hs-source-dirs:     app
    main-is:            Main.hs
    build-depends:
        base,
        compiler-lib,
        directory,
        bytestring,
        http-api-data,
        servant-server,
        text,
        wai,
        wai-app-static,
        wai-cors,
        warp
