cabal-version:      3.4
name:               compiler-lib
version:            0.1.0.0
author:             John Haynes
maintainer:         john.andrew.haynes@gmail.com
build-type:         Simple

common common
    ghc-options: -Wall -O2
    default-extensions: InstanceSigs, LambdaCase, OverloadedStrings, QuasiQuotes
    build-depends:
        base,
        bytestring,
        containers,
        transformers,
        vector,
        vector-builder

library
    import:           common
    exposed-modules:  Core.Expression
                      Core.Module
                      Parse.Expression
                      Parse.Lex
                      Parse.LexAndParse
                      Parse.Parser
                      Parse.Token
                      Pretty.Class
                      Pretty.Expression
                      Transform.Class
                      Transform.ClosureConvert
    hs-source-dirs:   src
    default-language: Haskell2010

test-suite compiler-lib-test
    import:           common
    default-language: Haskell2010
    type:             exitcode-stdio-1.0
    hs-source-dirs:   test
    main-is:          Test.hs
    other-modules:    Transform.ClosureConvertTest
    build-depends:
        compiler-lib
